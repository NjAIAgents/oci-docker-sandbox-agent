#!/usr/bin/env bash
# provision.sh — OCI ARM VM AD-rotation retry loop
#
# Generated by setup.sh. Do not edit placeholder values directly.
# Re-run setup.sh to regenerate with updated configuration.
#
# Usage:
#   terraform init   (first time only)
#   bash provision.sh
#
# Exit codes:
#   0 - SUCCESS: instance provisioned
#   2 - FATAL: service limit / quota reached
#   3 - FATAL: authentication failure
#   4 - FATAL: authorization failure (403 / NotAuthorized)
#   5 - FATAL: invalid parameter (400 / bad OCID or image)

set -uo pipefail

# ---- Configuration (filled in by setup.sh) ----
AD1="xXHb:US-CHICAGO-1-AD-1"
AD2="xXHb:US-CHICAGO-1-AD-2"
AD3="xXHb:US-CHICAGO-1-AD-3"
AD_SLEEP=60
ROUND_SLEEP=300
RATE_LIMIT_SLEEP=$(( 300 * 2 ))
INSTANCE_NAME="{{INSTANCE_NAME}}"

# ---- Log setup ----
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="${SCRIPT_DIR}/oci-provision.log"
ROUND=0

log() {
  local ts
  ts=$(date '+%Y-%m-%d %H:%M:%S')
  local msg="[$ts] $*"
  echo "$msg" | tee -a "$LOG_FILE"
}

fatal() {
  local msg="$1"
  local code="${2:-1}"
  log "FATAL: ${msg}"
  echo ""
  echo "  FATAL ERROR (exit ${code}): ${msg}"
  echo ""
  exit "$code"
}

# ---- Error classification ----
# Returns one of: capacity | limit | auth | forbidden | invalid |
#                 ratelimit | internal | unknown
classify_error() {
  local output="$1"

  if echo "$output" | grep -qE "Out of host capacity|InsufficientServiceCapacity"; then
    echo "capacity"
  elif echo "$output" | grep -qE "LimitExceeded|service limit|limit exceeded"; then
    echo "limit"
  elif echo "$output" | grep -qE "NotAuthenticated|401|InvalidAuthenticationToken"; then
    echo "auth"
  elif echo "$output" | grep -qE "Forbidden|403|NotAuthorized|not authorized"; then
    echo "forbidden"
  elif echo "$output" | grep -qE "InvalidParameter|400|invalid.*OCID|does not exist in compartment"; then
    echo "invalid"
  elif echo "$output" | grep -qE "TooManyRequests|429|rate limit|Rate limit"; then
    echo "ratelimit"
  elif echo "$output" | grep -qE "InternalError|500|503|internal server error|Service Unavailable"; then
    echo "internal"
  else
    echo "unknown"
  fi
}

# ---- Banner ----
echo ""
echo "============================================================"
echo "  OCI ARM VM Provisioner — AD Rotation Loop"
echo "  Instance: ${INSTANCE_NAME}"
echo "  ADs:      ${AD1} / ${AD2} / ${AD3}"
echo "  AD sleep: ${AD_SLEEP}s   Round sleep: ${ROUND_SLEEP}s"
echo "  Log:      ${LOG_FILE}"
echo "============================================================"
echo ""

log "Provisioner started. Instance: ${INSTANCE_NAME}"
log "ADs: ${AD1} | ${AD2} | ${AD3}"
log "Timing: AD_SLEEP=${AD_SLEEP}s  ROUND_SLEEP=${ROUND_SLEEP}s  RATE_LIMIT_SLEEP=${RATE_LIMIT_SLEEP}s"

# ---- Main loop ----
while true; do
  ROUND=$(( ROUND + 1 ))
  log "==============================  Round ${ROUND}  =============================="

  for AD in "$AD1" "$AD2" "$AD3"; do
    log "--- Attempting AD: ${AD} ---"

    # Destroy any partial state before applying.
    # Failure here is non-fatal — state may already be clean.
    log "Running: terraform destroy (cleanup partial state)"
    terraform destroy -auto-approve \
      -var "availability_domain=${AD}" \
      >> "$LOG_FILE" 2>&1 || true

    # Apply
    log "Running: terraform apply (AD=${AD})"
    TF_OUTPUT=$(terraform apply -auto-approve \
      -var "availability_domain=${AD}" 2>&1)
    TF_EXIT=$?

    # Append full apply output to log
    echo "$TF_OUTPUT" >> "$LOG_FILE"

    if [ "$TF_EXIT" -eq 0 ]; then
      # ---- SUCCESS ----
      log "SUCCESS: Instance provisioned in ${AD}"
      echo ""
      echo "============================================================"
      echo "  SUCCESS"
      echo "  Instance '${INSTANCE_NAME}' provisioned in: ${AD}"
      echo "============================================================"
      echo ""
      echo "  Get your public IP:"
      echo "    terraform output public_ip"
      echo ""
      echo "  Or via OCI CLI:"
      echo "    oci compute instance list-vnics \\"
      echo "      --instance-id \$(terraform output -raw instance_id) \\"
      echo "      | jq -r '.data[0].\"public-ip\"'"
      echo ""
      echo "  Then:"
      echo "    Edit your .env file and set VM_PUBLIC_IP=<ip>"
      echo "    make ssh   (from repo root)"
      echo ""
      echo "  Full log: ${LOG_FILE}"
      echo ""
      exit 0
    fi

    # ---- Classify the error ----
    ERROR_CLASS=$(classify_error "$TF_OUTPUT")
    log "Error class: ${ERROR_CLASS}"

    case "$ERROR_CLASS" in

      limit)
        fatal \
          "Service limit reached. You are already at the Always Free quota for VM.Standard.A1.Flex. Check https://cloud.oracle.com/limits and https://cloud.oracle.com/tenancy" \
          2
        ;;

      auth)
        fatal \
          "Authentication failed (401 / NotAuthenticated). Check ~/.oci/config: verify key_file path, fingerprint, tenancy OCID, and user OCID." \
          3
        ;;

      forbidden)
        fatal \
          "Authorization failed (403 / NotAuthorized). Your OCI user does not have permission to create compute instances in the target compartment. Add the policy: allow group <group> to manage instance-family in compartment <compartment>." \
          4
        ;;

      invalid)
        fatal \
          "Invalid parameter (400). Check terraform.tfvars: verify compartment_id, subnet OCID (if set), and image OCID. Common cause: compartment OCID typo or wrong region." \
          5
        ;;

      ratelimit)
        log "Rate limited (429 / TooManyRequests). Sleeping ${RATE_LIMIT_SLEEP}s then retrying ${AD} once more before rotating."
        sleep "$RATE_LIMIT_SLEEP"

        log "Retry after rate limit — AD: ${AD}"
        TF_OUTPUT2=$(terraform apply -auto-approve \
          -var "availability_domain=${AD}" 2>&1)
        TF_EXIT2=$?
        echo "$TF_OUTPUT2" >> "$LOG_FILE"

        if [ "$TF_EXIT2" -eq 0 ]; then
          log "SUCCESS: Instance provisioned in ${AD} (after rate limit retry)"
          echo ""
          echo "============================================================"
          echo "  SUCCESS (after rate limit retry)"
          echo "  Instance '${INSTANCE_NAME}' provisioned in: ${AD}"
          echo "============================================================"
          echo ""
          echo "  terraform output public_ip"
          echo ""
          exit 0
        fi

        log "Still failing after rate limit retry. Rotating to next AD."
        ;;

      internal)
        log "OCI internal error (5xx). Sleeping 120s then retrying ${AD} once more."
        sleep 120

        log "Retry after internal error — AD: ${AD}"
        TF_OUTPUT2=$(terraform apply -auto-approve \
          -var "availability_domain=${AD}" 2>&1)
        TF_EXIT2=$?
        echo "$TF_OUTPUT2" >> "$LOG_FILE"

        if [ "$TF_EXIT2" -eq 0 ]; then
          log "SUCCESS: Instance provisioned in ${AD} (after internal error retry)"
          echo ""
          echo "============================================================"
          echo "  SUCCESS (after internal error retry)"
          echo "  Instance '${INSTANCE_NAME}' provisioned in: ${AD}"
          echo "============================================================"
          echo ""
          echo "  terraform output public_ip"
          echo ""
          exit 0
        fi

        log "Still failing after internal error retry. Rotating to next AD."
        ;;

      capacity|unknown)
        log "No capacity in ${AD} (or unrecognised transient error). Rotating to next AD."
        ;;

    esac

    log "Sleeping ${AD_SLEEP}s before next AD..."
    sleep "$AD_SLEEP"

  done  # end AD loop

  log "All ADs exhausted in round ${ROUND}. Sleeping ${ROUND_SLEEP}s before round $(( ROUND + 1 ))..."
  sleep "$ROUND_SLEEP"

done  # end round loop
