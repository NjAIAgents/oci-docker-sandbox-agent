# oci-docker-sandbox-agent — environment variables
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Variables are grouped by the post that introduces them.
# Post 1 values are active. Later posts are commented out — uncomment
# when you reach that post.
#
# DO NOT commit your .env file. It is in .gitignore.

# ================================================================
# Post 1: OCI Provisioning
# ================================================================

# Your OCI region (e.g. us-chicago-1, eu-frankfurt-1, ap-sydney-1)
OCI_REGION=us-chicago-1

# Your tenancy OCID — find it at: Identity > Tenancy
# Format: ocid1.tenancy.oc1..aaaa...
OCI_TENANCY_OCID=

# Compartment to deploy into. Leave blank to use tenancy root.
# Format: ocid1.compartment.oc1..aaaa...
OCI_COMPARTMENT_OCID=

# Public IP of your provisioned VM.
# Fill this in after provision.sh reports SUCCESS.
# Then `make ssh` will work from repo root.
VM_PUBLIC_IP=

# Path to your SSH private key (paired with the public key you gave setup.sh)
VM_SSH_KEY=~/.ssh/id_rsa

# ================================================================
# Post 2: VM Hardening
# ================================================================
# Uncomment when you reach Post 2.

# VM_USER=ubuntu

# ================================================================
# Post 4: Agent Deployment
# ================================================================
# Uncomment when you reach Post 4.

# AGENT_API_KEY=
# AGENT_MODEL=

# ================================================================
# Post 6: Observability
# ================================================================
# Uncomment when you reach Post 6.

# GRAFANA_ADMIN_PASSWORD=
